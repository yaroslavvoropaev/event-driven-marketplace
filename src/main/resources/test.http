POST localhost:8080/api/auth/register
Content-Type: application/json

{
  "email": "bob@test.io",
  "password": "password123"
}

###
POST localhost:8080/api/auth/login
Content-Type: application/json

{"email": "bob@test.io", "password": "password123"}

> {%
    client.global.set("bobToken", response.body.token);
    client.global.set("bobId", response.body.user.id);
%}


###
GET localhost:8080/api/orders/{{o1}}
Authorization: Bearer {{bobToken}}

> {%
    client.test("это чужой заказ", () =>
        client.assert(response.body.customerId !== client.global.get("bobId")));
%}


